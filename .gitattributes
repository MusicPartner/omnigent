# Prettier-managed web text must check out as LF on every host.
web/**/*.json text eol=lf
web/**/*.ts text eol=lf
web/**/*.tsx text eol=lf
web/**/*.md text eol=lf
web/**/*.html text eol=lf
web/**/*.js text eol=lf
web/**/*.yml text eol=lf
web/**/*.yaml text eol=lf
web/**/*.jsx text eol=lf
web/**/*.cjs text eol=lf
web/**/*.mts text eol=lf
web/**/*.mjs text eol=lf
web/**/*.css text eol=lf

# Treat the AppIcon bundle's contents as binary and never merge them.
web/electron/icons/AppIcon.icon/** binary -merge

# Unified diff context has a leading space before the upstream indentation.
patches/*.patch -whitespace

# Protobuf bindings regenerated by scripts/gen_routing_pb2.py from the .proto
# schema. Mark them generated so review/code-quality tooling skips them (Ruff
# excludes them and Pyrefly ignores generated-code errors); the protoc output isn't
# hand-editable, so its unused-import/global artifacts are expected.
omnigent/api/**/*_pb2.py linguist-generated=true
omnigent/api/**/*_pb2.pyi linguist-generated=true
